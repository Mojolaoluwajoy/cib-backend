# Copy to .env (git-ignored) for local development and fill in real values.
# In production (Render), set these as environment variables instead.

# Database (local defaults are root/postgres if unset)
DB_USERNAME=root
DB_PASSWORD=postgres

# Base64-encoded HMAC key, at least 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=

# Gmail address + Google App Password (https://myaccount.google.com/apppasswords)
MAIL_USERNAME=
MAIL_PASSWORD=

# https://v6.exchangerate-api.com/v6/<YOUR_API_KEY>
EXCHANGE_RATE_BASE_URL=

PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
# test-bank with test keys; wema-bank or titan-paystack with live keys
PAYSTACK_DVA_PREFERRED_BANK=test-bank

# Only used to create the first SUPER_ADMIN on an empty database
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
