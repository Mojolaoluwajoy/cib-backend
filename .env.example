# Template for local configuration. Copy it and fill in real values:
#     cp .env.example .env
# .env is git-ignored and loaded automatically by the app. Never commit real values.
# In production (Render), set the same names as environment variables, plus SPRING_PROFILES_ACTIVE=prod.

# --- Database ---
# Must be a JDBC URL (jdbc:postgresql://host:port/db), not the postgres:// form hosting providers show.
DATABASE_URL=jdbc:postgresql://localhost:5432/corporate_internet_banking
DB_USERNAME=root
DB_PASSWORD=postgres

# --- Auth ---
# Base64-encoded HMAC key, at least 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_GENERATED_SECRET

# --- Email ---
# Local: Mailpit (docker run -d -p 1025:1025 -p 8025:8025 axllent/mailpit), inbox at http://localhost:8025
# Real Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_SMTP_AUTH=true, MAIL_SMTP_STARTTLS=true,
#             MAIL_PASSWORD = a Google App Password (https://myaccount.google.com/apppasswords)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_USERNAME=cib@localhost
MAIL_PASSWORD=

# --- Integrations ---
# https://v6.exchangerate-api.com/v6/<YOUR_API_KEY>
EXCHANGE_RATE_BASE_URL=https://v6.exchangerate-api.com/v6/REPLACE_WITH_API_KEY
# Paystack dashboard > Settings > API Keys & Webhooks (use test keys locally)
PAYSTACK_PUBLIC_KEY=pk_test_REPLACE_ME
PAYSTACK_SECRET_KEY=sk_test_REPLACE_ME
# test-bank with test keys; wema-bank or titan-paystack with live keys
PAYSTACK_DVA_PREFERRED_BANK=test-bank

# --- Transactions ---
# Hours a transfer/payout may wait for approval before it expires and its funds are released
TRANSACTION_APPROVAL_EXPIRY_HOURS=48

# --- Sessions and login protection (defaults shown) ---
# Access token lifetime in milliseconds (30 min) and refresh token lifetime in days
JWT_EXPIRATION_MS=1800000
REFRESH_TOKEN_DAYS=7
# The refresh token cookie. Secure needs HTTPS (default true in prod). Use SameSite=None only if the frontend
# is on a different site from the API, e.g. app.example.com vs api.other.com
# REFRESH_COOKIE_SECURE=false
# REFRESH_COOKIE_SAME_SITE=Strict
# Lock an email after this many failed logins, block an IP after this many, for LOGIN_LOCKOUT_MINUTES
LOGIN_MAX_FAILURES_PER_EMAIL=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_LOCKOUT_MINUTES=15
# Browser origins allowed to call the API, comma-separated. Defaults to FRONTEND_BASE_URL.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.example

# --- Frontend ---
# Used to build the invitation links sent by email
FRONTEND_BASE_URL=http://localhost:5173

# --- Logging ---
# true prints every SQL statement / Spring's auto-configuration report at startup
SHOW_SQL=false
APP_DEBUG=false
